# XAMPP's default MySQL/MariaDB root account has no password. Set one and add it
# here (mysql://root:PASSWORD@localhost:3306/sandig) before any real deployment.
DATABASE_URL="mysql://root@localhost:3306/sandig"
PORT=3000
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
AI_SERVICE_URL="http://localhost:8000"
NODE_ENV=development
