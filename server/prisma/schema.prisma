// SANDIG database schema.
//
// This mirrors the TypeScript interfaces in src/app/data/mockData.ts and
// src/app/data/riskModel.ts — those are the contract. Field names match the
// frontend exactly so the API can serialize straight to the shapes the pages
// already consume.
//
// Enum note: several frontend union members contain spaces ("Low Risk",
// "In Progress", "Chronic Illness"), which are not legal Prisma enum
// identifiers. Each value is therefore declared in PascalCase and @map-ed to
// the exact frontend string, so the database stores the literal the frontend
// expects. src/codecs.ts converts between the two at the API boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum RiskLevel {
  LowRisk      @map("Low Risk")
  ModerateRisk @map("Moderate Risk")
  HighRisk     @map("High Risk")
}

enum ReferralStatus {
  Pending
  Received
  InProgress @map("In Progress")
  Completed
  Escalated
  Cancelled
}

enum FollowUpStatus {
  Scheduled
  Completed
  Overdue
  Missed
}

enum DisabilityType {
  Physical
  Visual
  Hearing
  Intellectual
  Psychosocial
  Communication
  ChronicIllness @map("Chronic Illness")
}

enum PwdIdStatus {
  Active
  Expired
  Pending
}

enum CaseStatus {
  Open
  Reviewed
  Closed
}

enum UserStatus {
  Active
  Inactive
}

enum UpdateType {
  Referral
  Status
  Assessment
  Risk
  Profile
}

// ── Users ────────────────────────────────────────────────────────────────────

// Single-Administrator model (manuscript Section 1.5, FR-23). The system has
// exactly one direct user type: the Administrator / Assigned PWD Coordinator.
// The Barangay Health Center is an external, non-login entity and is therefore
// deliberately not represented here.
model SystemUser {
  id            String     @id @default(cuid())
  fullName      String
  username      String     @unique
  passwordHash  String
  role          String     @default("Administrator / Assigned PWD Coordinator")
  status        UserStatus @default(Active)
  lastLogin     DateTime?
  contactNumber String     @default("")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  assessments         Assessment[] @relation("AssessedBy")
  confirmedAssessments Assessment[] @relation("ConfirmedBy")
  auditLogs           AuditLog[]

  @@map("system_users")
}

// ── PWD profiles ─────────────────────────────────────────────────────────────

model PwdProfile {
  id                    String         @id @default(cuid())
  fullName              String
  dateOfBirth           DateTime       @db.Date
  sex                   String
  address               String
  contactNumber         String         @default("")
  civilStatus           String         @default("")
  disabilityType        DisabilityType
  pwdIdNumber           String         @unique
  pwdIdStatus           PwdIdStatus    @default(Active)
  dateRegistered        DateTime       @db.Date
  assistiveDevice       String         @default("None")
  householdSize         Int            @default(1)
  livingCondition       String         @default("")
  incomeBracket         String         @default("")
  supportSituation      String         @default("")
  caregiverName         String         @default("None")
  caregiverRelationship String         @default("N/A")
  caregiverContact      String         @default("N/A")
  caregiverAvailability String         @default("No caregiver")
  purok                 String
  // Current confirmed risk level, denormalized for the FR-18 default ordering
  // and FR-19 dashboard counts. Recomputed whenever an assessment is confirmed.
  riskStatus            RiskLevel      @default(LowRisk)
  active                Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  assessments Assessment[]
  referrals   Referral[]
  atRiskCase  AtRiskCase?

  @@index([riskStatus])
  @@map("pwd_profiles")
}

// ── Assessments ──────────────────────────────────────────────────────────────

// One assessment row is the authoritative record of a single scoring event.
// It carries the intake answers, the six coded indicators, the server-computed
// rule-based result, the advisory AI result (stored SEPARATELY — never merged
// into one number, per FR-09), the human confirmation (FR-10/FR-11), and the
// traceability fields required by FR-25.
model Assessment {
  id         String     @id @default(cuid())
  pwdId      String
  pwd        PwdProfile @relation(fields: [pwdId], references: [id], onDelete: Cascade)
  date       DateTime   @default(now())
  assessedById String
  assessedBy   SystemUser @relation("AssessedBy", fields: [assessedById], references: [id])

  // Intake answers (health + assistive device only — the system is scoped to
  // health-related referral, so caregiver/accessibility/education are absent).
  healthConcern     String @default("")
  checkupAttendance String @default("Regular")
  therapyAttendance String @default("Regular")
  medicationAccess  String @default("Accessible")
  deviceType        String @default("")
  deviceCondition   String @default("Good")
  needsRepair       Boolean @default(false)
  needsReplacement  Boolean @default(false)
  urgentNeed        String @default("")
  remarks           String @default("")
  recommendedAction String @default("")

  // The six coded scoring indicators. Stored as six discrete booleans rather
  // than a JSON blob: the set is fixed and closed, and the FR-19 "common health
  // concerns" aggregate is a plain COUNT per column this way.
  unresolvedHealthNeed   Boolean @default(false)
  pendingReferral        Boolean @default(false)
  missedCheckup          Boolean @default(false)
  medicationConcern      Boolean @default(false)
  treatmentTherapyNeed   Boolean @default(false)
  urgentMedicalCondition Boolean @default(false)

  // Rule-based result — computed server-side (FR-07), authoritative.
  ruleScore               Int
  ruleLevel               RiskLevel
  ruleVersion             String  @default("rule-v1")
  triggersImmediateReview Boolean @default(false)

  // AI result — advisory only, kept in its own columns.
  aiPredicted     RiskLevel?
  aiProbLow       Float?
  aiProbModerate  Float?
  aiProbHigh      Float?
  aiModelVersion  String?
  aiPredictedAt   DateTime?

  // Human confirmation — required before any referral action (FR-10/FR-11).
  confirmedLevel RiskLevel?
  confirmedById  String?
  confirmedBy    SystemUser? @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt    DateTime?
  overridden     Boolean?

  atRiskCase AtRiskCase?

  @@index([pwdId, date])
  @@map("assessments")
}

// ── At-risk cases ────────────────────────────────────────────────────────────

// Case-management state for a flagged PWD. The risk numbers themselves are NOT
// duplicated here — they are read through `assessment`, so there is exactly one
// source of truth for a score. The API composes the frontend's AtRiskCase shape
// by joining the two.
model AtRiskCase {
  id             String         @id @default(cuid())
  pwdId          String         @unique
  pwd            PwdProfile     @relation(fields: [pwdId], references: [id], onDelete: Cascade)
  assessmentId   String         @unique
  assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  flagReason     String
  dateFlagged    DateTime       @default(now())
  followUpStatus FollowUpStatus @default(Scheduled)
  status         CaseStatus     @default(Open)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("at_risk_cases")
}

// ── Referrals ────────────────────────────────────────────────────────────────

model Referral {
  id             String         @id @default(cuid())
  pwdId          String
  pwd            PwdProfile     @relation(fields: [pwdId], references: [id], onDelete: Cascade)
  // Always "Medical / Health" — SANDIG records Health Referrals only
  // (manuscript Section 1.5, FR-06, FR-12). Kept for schema consistency and
  // report legibility; it is never a user choice.
  referralType   String         @default("Medical / Health")
  identifiedNeed String
  referralReason String
  referredOffice String
  receiverName   String         @default("")
  referralDate   DateTime       @db.Date
  followUpDate   DateTime?      @db.Date
  // Follow-up progress uses its own vocabulary and is deliberately distinct
  // from `status` below, which is the referral vocabulary.
  followUpStatus FollowUpStatus @default(Scheduled)
  priorityLevel  RiskLevel
  status         ReferralStatus @default(Pending)
  outcome        String         @default("")
  remarks        String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([followUpDate])
  @@map("referrals")
}

// ── Activity feed and audit trail ────────────────────────────────────────────

model RecentUpdate {
  id       String     @id @default(cuid())
  type     UpdateType
  actor    String
  action   String
  subject  String
  dateTime DateTime   @default(now())

  @@index([dateTime])
  @@map("recent_updates")
}

// FR-22 audit trail. Written by centralized middleware, not per-route.
model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     SystemUser? @relation(fields: [userId], references: [id])
  userName String
  action   String
  module   String
  method   String   @default("")
  path     String   @default("")
  status   Int      @default(0)
  ip       String   @default("")
  dateTime DateTime @default(now())

  @@index([dateTime])
  @@map("audit_logs")
}
